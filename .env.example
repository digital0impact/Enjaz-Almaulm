## Non-public / server-only (للسكربتات المحلية فقط - لا تضعها في EXPO_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

## IAP (للتحقق من المشتريات - لا تعرّض الأسرار في العميل)
IOS_SHARED_SECRET="YOUR_APPLE_SHARED_SECRET"
ANDROID_PLAY_ACCESS_TOKEN="YOUR_GOOGLE_PLAY_ACCESS_TOKEN"

## رابط التطبيق على الويب - يُستخدم لنسيان كلمة المرور وكرابط عودة بعد الدفع
## ملاحظة: بعد فصل صفحة الهبوط إلى www.enjaz-almaulm.com، أصبح التطبيق نفسه
## على app.enjaz-almaulm.com — تأكدي من تحديث هذه القيمة في إعدادات Vercel
## لمشروع Enjaz-Almaulm الفعلي (وليس فقط هنا في .env.example المحلي)
EXPO_PUBLIC_APP_URL="https://app.enjaz-almaulm.com"

## حساب العرض التجريبي (Demo) - يُستخدم في صفحة /demo لتسجيل دخول تلقائي
## بحساب معلم تجريبي جاهز عند الوصول من زر "تجربة نموذجية" في صفحة الهبوط
EXPO_PUBLIC_DEMO_EMAIL="demo@enjaz-almaulm.com"
EXPO_PUBLIC_DEMO_PASSWORD="YOUR_DEMO_ACCOUNT_PASSWORD"

## متجر الويب (اختياري) - روابط صفحات المنتجات (صفحة المنتج وليس عربة الشراء)
## سلة: من لوحة سلة انسخ رابط صفحة كل منتج (الاشتراك السنوي، الاشتراك النصف سنوي)
## إذا لم تضبط هذه، يُستخدم EXPO_PUBLIC_WEB_STORE_URL مع ?plan=yearly أو ?plan=half_yearly كبديل
# EXPO_PUBLIC_WEB_STORE_URL_YEARLY="https://your-store.salla.sa/products/product-yearly"
# EXPO_PUBLIC_WEB_STORE_URL_HALF_YEARLY="https://your-store.salla.sa/products/product-half-yearly"
# EXPO_PUBLIC_WEB_STORE_URL="https://your-store.salla.sa/cart"
